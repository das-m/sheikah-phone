/* global transitions */

.fade-enter-active
.fade-leave-active
    transition opacity 1s 1s ease

.fade-enter-from
.fade-leave-to
    opacity 0

/* global animations */

@keyframes spin
    from
        transform rotate(0deg)
    to
        transform rotate(360deg)

/* lightbox */

.pswp

    &__bg
        background var(--color-base) url(@/assets/images/background/background.png) !important
        backdrop-filter blur(8px)
        
    &__top-bar
        top auto !important
        bottom 80px
        justify-content center !important

    &__preloader
        position absolute
        top 0
        left calc(50% - 25px)