:root
  --sp-color--base #010710
  --sp-color--contrast #E2DED3
  --sp-color--primary #3CD3FC
  --sp-color--primary--hover #BAEFFB
  --sp-color--secondary #FFE460
  --sp-color--secondary--hover #FCC413
  --sp-color--red #F15050

/* semantic color variables for this project */
:root 
  --color-base var(--sp-color--base)
  --color-contrast var(--sp-color--contrast)
  --color-primary var(--sp-color--primary)
  --color-primary-hover  var(--sp-color--primary--hover )
  --color-secondary var(--sp-color--secondary)
  --color-secondary-hover  var(--sp-color--secondary--hover )
  --color-red  var(--sp-color--red )

  --section-gap 3rem

/* Yiga mode (set on <html> by useYigaMode): the blue accent turns red */
:root[data-mode='yiga']
  --sp-color--primary #F15050
  --sp-color--primary--hover #FBBABA
  --sp-color--base #100301
